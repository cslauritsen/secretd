[Unit]
Description=secretd admin socket (root only)
Documentation=https://github.com/cslauritsen/secretd

[Socket]
ListenStream=/run/secretd/admin.sock
FileDescriptorName=admin
# Root-owned and 0600; secretd additionally requires SO_PEERCRED uid 0.
SocketMode=0600
SocketUser=root
SocketGroup=root
DirectoryMode=0755
Service=secretd.service

[Install]
WantedBy=sockets.target
