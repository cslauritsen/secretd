[Unit]
Description=secretd client socket
Documentation=https://github.com/cslauritsen/secretd

[Socket]
ListenStream=/run/secretd/secretd.sock
FileDescriptorName=secretd
# Real access control is the per-secret ACL (uid/gid/exe + owner approval), not the
# file mode. The socket belongs to a DEDICATED group, secretd-clients: add the users
# who may ask for secrets to it (`usermod -aG secretd-clients alice`). Never use the
# `secretd` group here: that group can read /etc/secretd, and being allowed to
# connect must not imply access to the daemon's files. (SocketMode=0666 would let
# every local user ask; the ACLs still apply.)
SocketMode=0660
SocketUser=secretd
SocketGroup=secretd-clients
# /run/secretd itself is created 0755 secretd:secretd by tmpfiles.d/secretd.conf.
DirectoryMode=0755
Service=secretd.service

[Install]
WantedBy=sockets.target
