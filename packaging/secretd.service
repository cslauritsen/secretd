[Unit]
Description=secretd - local secrets-release daemon
Documentation=https://github.com/cslauritsen/secretd
After=network-online.target
Wants=network-online.target
Requires=secretd.socket secretd-admin.socket

[Service]
Type=simple
User=secretd
Group=secretd
ExecStart=/usr/bin/secretd --config /etc/secretd/config.toml
# Reload ACLs/limits from the config (SIGHUP).
ExecReload=/bin/kill -HUP $MAINPID
Sockets=secretd.socket secretd-admin.socket
Restart=on-failure
RestartSec=2s

# --- state, logs, config -----------------------------------------------------
StateDirectory=secretd
StateDirectoryMode=0700
LogsDirectory=secretd
LogsDirectoryMode=0750
UMask=0077
# /run/secretd/pipes: where secretd creates the named pipes of [[fifo]] entries (a leading
# "-" ignores the path if no pipe directory exists, i.e. when you use no [[fifo]]).
ReadWritePaths=/var/lib/secretd /var/log/secretd -/run/secretd/pipes

# --- hardening ---------------------------------------------------------------
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Explicitly deny the calls that read or tamper with other processes' memory or
# steal their descriptors, even if a later @group edit would allow them. The daemon
# holds CAP_SYS_PTRACE (below), so this filter is what keeps a compromised secretd
# from using it for more than reading /proc/<pid>/exe.
SystemCallFilter=~ptrace process_vm_readv process_vm_writev pidfd_getfd
SystemCallErrorNumber=EPERM
LimitCORE=0

# --- resource limits -----------------------------------------------------------
# Descriptors: per client connection a socket and a pidfd, plus the approval
# connections and ~64 for listeners, log, store and notification calls. The
# defaults (128 connections, 64 approval connections) need about 380; if you raise
# limits.max_conns_total or approval.max_connections, raise this too (secretd warns
# at startup when the limit is too low).
LimitNOFILE=1024
# mlock of passphrase and plaintext buffers.
LimitMEMLOCK=32M
# One scrypt derivation needs 128 MiB * 2^(logN-17): about 256 MiB at age's default
# (logN 18), 512 MiB at 19. Unsealing is serialised, so one derivation at a time.
# Raise this if you re-encrypt the store with a work factor above 19.
MemoryMax=1G
MemorySwapMax=0
TasksMax=64

# secretd must read /proc/<pid>/exe of clients that run as other uids. The kernel
# requires PTRACE_MODE_READ_FSCREDS for that, i.e. CAP_SYS_PTRACE (see
# docs/HARDENING.md). This is the only capability the service keeps. Do NOT add
# PrivateUsers= or ProtectProc=invisible: they hide or remap other users' processes
# and make every request fail closed.
CapabilityBoundingSet=CAP_SYS_PTRACE
AmbientCapabilities=CAP_SYS_PTRACE

[Install]
WantedBy=multi-user.target
