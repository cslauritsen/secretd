[Unit]
Description=secretd - local secrets-release daemon
Documentation=https://github.com/cslauritsen/secretd
After=network-online.target
Wants=network-online.target
Requires=secretd.socket secretd-admin.socket

[Service]
Type=simple
User=secretd
Group=secretd
ExecStart=/usr/bin/secretd --config /etc/secretd/config.toml
# Reload ACLs/limits from the config (SIGHUP).
ExecReload=/bin/kill -HUP $MAINPID
Sockets=secretd.socket secretd-admin.socket
Restart=on-failure
RestartSec=2s

# --- state, logs, config -----------------------------------------------------
StateDirectory=secretd
StateDirectoryMode=0700
LogsDirectory=secretd
LogsDirectoryMode=0750
UMask=0077
ReadWritePaths=/var/lib/secretd /var/log/secretd

# --- hardening ---------------------------------------------------------------
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
LimitCORE=0

# secretd must read /proc/<pid>/exe of clients that run as other uids. The kernel
# requires PTRACE_MODE_READ_FSCREDS for that, i.e. CAP_SYS_PTRACE (see
# docs/HARDENING.md). This is the only capability the service keeps. Do NOT add
# PrivateUsers= or ProtectProc=invisible: they hide or remap other users' processes
# and make every request fail closed.
CapabilityBoundingSet=CAP_SYS_PTRACE
AmbientCapabilities=CAP_SYS_PTRACE

[Install]
WantedBy=multi-user.target
