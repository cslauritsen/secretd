<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  secretd as a LaunchDaemon (macOS). Install to /Library/LaunchDaemons/org.secretd.secretd.plist,
  owner root:wheel, mode 0644 (launchd refuses anything else). See README.md in this directory.

  The job starts as root on purpose and has NO UserName key: secretd binds its sockets
  while root (macOS clears /var/run at boot, and only root can recreate /var/run/secretd),
  gives the client socket to the daemon user, then drops to `daemon.user` (`_secretd` in
  config.macos.example.toml) and verifies it cannot regain root. After startup the process
  runs as `_secretd`, like the systemd unit. Setting `user = "root"` in the config keeps
  root instead (see docs/HARDENING.md, "macOS").
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.secretd.secretd</string>

    <!-- Adjust the path to where you installed the binaries (/opt/homebrew/bin on Apple silicon Homebrew). -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/secretd</string>
        <string>--config</string>
        <string>/etc/secretd/config.toml</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <!-- Restart on any exit, including a crash; ThrottleInterval spaces out restarts so a
         refused configuration (the daemon exits non-zero) does not spin. -->
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- launchd opens these as root; the audit log is separate and written by the daemon. -->
    <key>StandardOutPath</key>
    <string>/var/log/secretd/secretd.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/secretd/secretd.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>RUST_LOG</key>
        <string>info</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/var/empty</string>
    <key>Umask</key>
    <integer>63</integer> <!-- 0077 -->

    <!-- macOS defaults to 256 descriptors; the default limits can need about 380
         (2 per client connection plus the approval connections, see secretd's startup warning). -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>1024</integer>
        <key>Core</key>
        <integer>0</integer>
    </dict>
    <key>HardResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>1024</integer>
        <key>Core</key>
        <integer>0</integer>
    </dict>

    <!--
      Optional launchd socket activation (default: secretd binds its own sockets). To let
      launchd create the client socket instead, add the dictionary below (SockPathMode is decimal:
      432 is 0660). secretd asks launchd
      for the entries named "secretd" (client) and "admin" and uses them when present; the
      mode and owner then come from here, not from config.toml (`socket_mode`, `socket_group`).
      Not exercised by the automated tests; verify on your machine before relying on it.

    <key>Sockets</key>
    <dict>
        <key>secretd</key>
        <dict>
            <key>SockPathName</key>
            <string>/var/run/secretd/secretd.sock</string>
            <key>SockPathMode</key>
            <integer>432</integer>
            <key>SockPathOwner</key>
            <integer>UID of _secretd</integer>
            <key>SockPathGroup</key>
            <integer>GID of _secretd-clients</integer>
        </dict>
    </dict>
    -->
</dict>
</plist>
