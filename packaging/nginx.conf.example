# nginx in front of secretd's plain-HTTP approval endpoint.
# Only /approve/, /auth/ and /healthz are forwarded; everything else is 404.
# secretd trusts X-Forwarded-For only from peers in approval.trusted_proxies
# (default: 127.0.0.1 and ::1), so keep nginx on the same host or add its address.

server {
    listen 80;
    server_name secretd.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name secretd.example.com;

    ssl_certificate     /etc/letsencrypt/live/secretd.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/secretd.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=63072000" always;

    client_max_body_size 16k;

    location ~ ^/(approve/|auth/|healthz$) {
        proxy_pass http://127.0.0.1:8443;
        # Must match approval.external_url: secretd rejects other Host headers.
        proxy_set_header Host              $host;
        # Replace (do not append to) any client-supplied header.
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }

    location / {
        return 404;
    }
}
